<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:me="Mentality.Presentation.Views" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/ButtonUSS.uss?fileID=7433441132597879392&amp;guid=49524d7b6231e50428f235b106fc641b&amp;type=3#ButtonUSS"/>
    <ui:VisualElement style="flex-grow: 1; position: absolute; top: 0%; left: 0%; right: 0%; bottom: 0%; background-color: rgb(0, 0, 0);"/>
    <ui:VisualElement name="TitleContainer" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/UI/title.gif?fileID=2800000&amp;guid=8a8028192ce198d4a9b685be5df0fd29&amp;type=3#title&quot;); -unity-background-scale-mode: scale-to-fit;">
        <ui:VisualElement style="flex-grow: 1; left: 20%; right: 20%; position: absolute; top: 25%; bottom: 25%;"/>
    </ui:VisualElement>
    <ui:VisualElement name="MenuContainer" style="width: 35%; height: 200px; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.5); padding: 20px; flex-grow: 1; align-self: flex-end;">
        <ui:VisualElement style="width: 100%; height: 100px; position: relative;">
            <me:MenuButton text="Nueva Partida" name="newBtn"/>
        </ui:VisualElement>
        <ui:VisualElement style="width: 100%; height: 100px; position: relative;">
            <me:MenuButton text="Continuar" name="continueBtn"/>
        </ui:VisualElement>
        <ui:VisualElement style="width: 100%; height: 100px; position: relative;">
            <me:MenuButton text="Ajustes" name="optionsBtn"/>
        </ui:VisualElement>
        <ui:VisualElement style="width: 100%; height: 100px; position: relative;">
            <me:MenuButton text="Salir" name="exitBtn"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
