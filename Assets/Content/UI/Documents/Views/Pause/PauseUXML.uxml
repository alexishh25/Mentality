<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:me="Mentality.UI.Views" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/UI/Styles/ButtonUSS.uss?fileID=7433441132597879392&amp;guid=49524d7b6231e50428f235b106fc641b&amp;type=3#ButtonUSS" />
    <Style src="/Assets/Content/UI/Styles/ResultsUSS.uss" />
    <ui:VisualElement name="pauseScreen" class="mg01-screen">
        <ui:VisualElement style="flex-grow: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.5); padding: 20px; align-self: center; align-content: center; width: 60%;">
            <ui:Label name="pauseTitle" text="PAUSA" class="mg01-title" />
            <ui:VisualElement class="mg01-pause-slot">
                <me:MenuButton text="Reanudar" name="resumeBtn" />
            </ui:VisualElement>
            <ui:VisualElement class="mg01-pause-slot">
                <me:MenuButton text="Ajustes" name="settingsBtn" />
            </ui:VisualElement>
            <ui:VisualElement class="mg01-pause-slot">
                <me:MenuButton text="Salir" name="exitBtn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
