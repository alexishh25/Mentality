<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:me="Mentality.UI.Views" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/UI/Styles/ButtonUSS.uss?fileID=7433441132597879392&amp;guid=49524d7b6231e50428f235b106fc641b&amp;type=3#ButtonUSS"/>
    <ui:VisualElement name="TitleContainer" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Audio/SFX/UI/title.gif?fileID=2800000&amp;guid=8a8028192ce198d4a9b685be5df0fd29&amp;type=3#title&quot;); -unity-background-scale-mode: scale-to-fit;">
        <ui:VisualElement style="flex-grow: 1; left: 20%; right: 20%; position: absolute; top: 25%; bottom: 25%;"/>
    </ui:VisualElement>
    <ui:VisualElement name="MenuContainer" style="width: 35%; height: 200px; align-items: center; justify-content: center; padding: 20px; flex-grow: 1; align-self: flex-end;">
        <ui:VisualElement style="width: 100%; height: 60%; position: relative;">
            <me:MenuButton text="Nueva Partida" name="newBtn"/>
        </ui:VisualElement>
        <ui:VisualElement style="width: 100%; height: 60%; position: relative;">
            <me:MenuButton text="Continuar" name="continueBtn"/>
