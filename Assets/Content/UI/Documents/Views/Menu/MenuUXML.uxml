        </ui:VisualElement>
        <ui:VisualElement style="width: 100%; height: 60%; position: relative;">
            <me:MenuButton text="Salir" name="exitBtn"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
