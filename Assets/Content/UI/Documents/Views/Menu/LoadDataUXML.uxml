<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="ButtonUXML" src="project://database/Assets/Content/UI/Documents/Elements/ButtonUXML.uxml?fileID=9197481963319205126&amp;guid=1fb6c537e731b2b4f858b939c1008f3e&amp;type=3#ButtonUXML"/>
    <Style src="project://database/Assets/Content/UI/Styles/ButtonUSS.uss?fileID=7433441132597879392&amp;guid=49524d7b6231e50428f235b106fc641b&amp;type=3#ButtonUSS"/>
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 1; margin-top: 5%; margin-right: 5%; margin-bottom: 5%; margin-left: 5%; border-top-left-radius: 7%; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-left-color: rgb(12, 68, 174); border-right-color: rgb(12, 68, 174); border-top-color: rgb(12, 68, 174); border-bottom-color: rgb(12, 68, 174); border-bottom-right-radius: 7%; background-color: rgba(0, 0, 0, 0.45);">
            <ui:Label text="Selecciona tu partida" style="flex-grow: 0.2; color: rgb(255, 255, 255); -unity-text-align: middle-center; -unity-text-auto-size: best-fit 10px 100px; -unity-text-generator: advanced; -unity-font-definition: url(&quot;project://database/Assets/Content/Fonts/m3x6.ttf?fileID=12800000&amp;guid=44f9e4e98ef6b0c4f8e4b05596790f4e&amp;type=3#m3x6&quot;);"/>
            <ui:VisualElement style="flex-grow: 1;">
                <ui:ListView/>
                <Mentality.UI.Views.MenuButton name="MenuButton" text="Crear partida nueva" style="height: 30%; margin-right: 5%; margin-left: 5%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
